\name{get_player_data}
\alias{get_player_data}
\title{Get tennis player career match data}
\usage{
get_player_data(player_name)
}
\arguments{
\item{player_name}{Name of a tennis player.}
}
\description{
Retrieves career match data from Tennis Abstract and
returns a cleaned data frame with match dates, opponents,
results, player ages, opponent ages, and age differences.
}
\value{
A data frame containing cleaned career match data.
}
